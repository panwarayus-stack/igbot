# Copy this file to .env and fill in your values. Never commit .env.

# Instagram account the bot logs in as (placeholder values shown).
IG_USERNAME=your_instagram_username
IG_PASSWORD=your_instagram_password

# Required. Encrypts the saved session file. Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_a_long_random_string_of_at_least_32_chars

# Command prefix (1-3 characters).
BOT_PREFIX=!

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Directory for session and auth state. Relative paths resolve from the project root.
DATA_DIR=data

# How often to poll the direct inbox, in milliseconds (minimum 5000).
POLL_INTERVAL_MS=10000

# Minutes to pause login attempts after an authentication failure (multiplied for some failure types).
LOGIN_COOLDOWN_MINUTES=60

# development | production | test
NODE_ENV=production
